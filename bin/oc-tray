#!/usr/bin/env python3
"""oc-tray - a system tray icon for the opencode companion.

Registers a StatusNotifierItem on the session bus, plus a proper DBusMenu, so
the icon sits in the tray with everything else and its menu is drawn by the
tray host in the right place.

    oc-tray            run the icon
    oc-tray --icon     (re)generate the icon file and exit
"""

from __future__ import annotations

import os
import subprocess
import sys

from gi.repository import Gio, GLib

HOME = os.path.expanduser("~")
ICON_DIR = os.path.join(HOME, ".local/share/icons/hicolor/128x128/apps")
ICON_PATH = os.path.join(ICON_DIR, "oc-companion.png")
CONFIG = os.path.join(HOME, ".config/oc-companion/config.json")

ACCENT = (243, 141, 112)
HAIR = (74, 59, 82)
HAIR_DARK = (58, 46, 64)
SKIN = (243, 217, 201)
EYE = (43, 34, 48)
BLUSH = (255, 154, 162)

SNI_XML = """
<node>
  <interface name='org.freedesktop.DBus.Introspectable'/>
  <interface name='org.freedesktop.DBus.Properties'>
    <method name='Get'>
      <arg type='s' name='interface_name' direction='in'/>
      <arg type='s' name='property_name' direction='in'/>
      <arg type='v' name='value' direction='out'/>
    </method>
    <method name='GetAll'>
      <arg type='s' name='interface_name' direction='in'/>
      <arg type='a{sv}' name='properties' direction='out'/>
    </method>
    <signal name='PropertiesChanged'>
      <arg type='s' name='interface_name'/>
      <arg type='a{sv}' name='changed_properties'/>
      <arg type='as' name='invalidated_properties'/>
    </signal>
  </interface>
  <interface name='org.kde.StatusNotifierItem'>
    <property name='Category' type='s' access='read'/>
    <property name='Id' type='s' access='read'/>
    <property name='Title' type='s' access='read'/>
    <property name='Status' type='s' access='read'/>
    <property name='IconName' type='s' access='read'/>
    <property name='OverlayIconName' type='s' access='read'/>
    <property name='AttentionIconName' type='s' access='read'/>
    <property name='ToolTip' type='(sa(iiay)ss)' access='read'/>
    <property name='ItemIsMenu' type='b' access='read'/>
    <property name='Menu' type='o' access='read'/>
    <method name='Activate'>
      <arg type='i' name='x' direction='in'/>
      <arg type='i' name='y' direction='in'/>
    </method>
    <method name='SecondaryActivate'>
      <arg type='i' name='x' direction='in'/>
      <arg type='i' name='y' direction='in'/>
    </method>
    <method name='ContextMenu'>
      <arg type='i' name='x' direction='in'/>
      <arg type='i' name='y' direction='in'/>
    </method>
    <method name='Scroll'>
      <arg type='i' name='delta' direction='in'/>
      <arg type='s' name='orientation' direction='in'/>
    </method>
  </interface>
</node>
"""

MENU_PROPERTIES = """
    <property name='Version' type='u' access='read'/>
    <property name='Status' type='s' access='read'/>
    <property name='TextDirection' type='s' access='read'/>
    <property name='IconThemePath' type='as' access='read'/>
"""

MENU_METHODS = """
    <method name='GetLayout'>
      <arg type='i' name='parentId' direction='in'/>
      <arg type='i' name='recursionDepth' direction='in'/>
      <arg type='as' name='propertyNames' direction='in'/>
      <arg type='u' name='revision' direction='out'/>
      <arg type='(ia{sv}av)' name='layout' direction='out'/>
    </method>
    <method name='GetGroupProperties'>
      <arg type='ai' name='ids' direction='in'/>
      <arg type='as' name='propertyNames' direction='in'/>
      <arg type='a(ia{sv})' name='properties' direction='out'/>
    </method>
    <method name='GetProperty'>
      <arg type='i' name='id' direction='in'/>
      <arg type='s' name='name' direction='in'/>
      <arg type='v' name='property' direction='out'/>
    </method>
    <method name='Event'>
      <arg type='i' name='id' direction='in'/>
      <arg type='s' name='eventId' direction='in'/>
      <arg type='v' name='data' direction='in'/>
      <arg type='u' name='timestamp' direction='in'/>
    </method>
    <method name='AboutToShow'>
      <arg type='i' name='id' direction='in'/>
      <arg type='b' name='needUpdate' direction='out'/>
    </method>
    <method name='ContextMenuAboutToShow'>
      <arg type='i' name='id' direction='in'/>
      <arg type='b' name='needUpdate' direction='out'/>
    </method>
"""

# The libdbusmenu name is the one tray hosts actually ask for; the
# freedesktop spelling is an alias. Export the menu under both names.
MENU_INTERFACES = ("com.canonical.dbusmenu", "org.freedesktop.DBusMenu")


def menu_xml(interface_names) -> str:
    interfaces = "".join(
        f"  <interface name='{name}'>\n{MENU_PROPERTIES}{MENU_METHODS}"
        f"  </interface>\n"
        for name in interface_names)
    return f"<node>\n{interfaces}</node>\n"

# id, label, what it does
MENU_ITEMS = [
    (1, "Ask something...", "summon"),
    (2, "New conversation", "reset"),
    (3, "Copy last reply", "copy"),
    (4, "Hide companion", "dismiss"),
    (5, "Settings", "settings"),
]


def draw_icon(size: int = 128) -> None:
    """Draw the companion's head as a PNG icon."""
    from PIL import Image, ImageDraw

    s = size
    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)

    def ell(box, color, outline=None, width=0):
        d.ellipse(box, fill=color, outline=outline, width=width)

    ell((s * 0.12, s * 0.08, s * 0.88, s * 0.86), HAIR_DARK)
    ell((s * 0.18, s * 0.14, s * 0.82, s * 0.80), SKIN)
    d.pieslice((s * 0.18, s * 0.14, s * 0.82, s * 0.52), 180, 360, fill=HAIR)
    d.ellipse((s * 0.30, s * 0.30, s * 0.50, s * 0.46), fill=HAIR)
    d.ellipse((s * 0.52, s * 0.28, s * 0.72, s * 0.44), fill=HAIR)
    ell((s * 0.32, s * 0.46, s * 0.42, s * 0.60), EYE)
    ell((s * 0.58, s * 0.46, s * 0.68, s * 0.60), EYE)
    ell((s * 0.345, s * 0.485, s * 0.385, s * 0.525), (255, 255, 255))
    ell((s * 0.605, s * 0.485, s * 0.645, s * 0.525), (255, 255, 255))
    ell((s * 0.25, s * 0.60, s * 0.35, s * 0.66), BLUSH)
    ell((s * 0.65, s * 0.60, s * 0.75, s * 0.66), BLUSH)
    ell((s * 0.47, s * 0.65, s * 0.53, s * 0.71), (122, 59, 72))
    d.rounded_rectangle((s * 0.26, s * 0.78, s * 0.74, s * 1.02),
                        radius=int(s * 0.12), fill=ACCENT)

    os.makedirs(ICON_DIR, exist_ok=True)
    img.save(ICON_PATH)


def companion_ipc(function: str, *args: str) -> None:
    cmd = ["quickshell", "ipc", "-c", "companion", "call", "companion", function]
    cmd += list(args)
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass


def item_properties(item_id: int) -> dict:
    """A menu item's properties, as a dict of variants."""
    for iid, label, _ in MENU_ITEMS:
        if iid == item_id:
            return {
                "type": GLib.Variant("s", "standard"),
                "label": GLib.Variant("s", label),
                "enabled": GLib.Variant("b", True),
                "visible": GLib.Variant("b", True),
                "disposition": GLib.Variant("s", "normal"),
            }
    return {}


def build_layout(item_id: int, depth: int):
    """One menu node: (id, properties, children)."""
    children = []
    if item_id == 0:
        for iid, _label, _action in MENU_ITEMS:
            if depth == 0:
                break
            children.append(GLib.Variant(
                "(ia{sv}av)", (iid, item_properties(iid), [])))

    return (item_id, item_properties(item_id), children)


class Tray:
    def __init__(self):
        self.loop = GLib.MainLoop()
        self.service_name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        self.registered = False
        self.connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)

        # g_bus_own_name loses the name immediately under dbus-broker, so
        # ask the bus for it directly.
        reply = self.connection.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus",
            "org.freedesktop.DBus", "RequestName",
            GLib.Variant("(su)", (self.service_name, 0x4)),
            GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1, None)
        result = reply.unpack()[0]
        if result not in (1, 4):   # PRIMARY_OWNER or ALREADY_OWNER
            raise RuntimeError(f"could not take the bus name ({result})")

        self.on_name_acquired(self.connection, self.service_name)
        self.register_with_watcher()

    def on_name_acquired(self, connection, name):
        # One registration per path: Gio serves org.freedesktop.DBus.Properties
        # itself for an interface that has properties.
        sni_info = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
        sni = next(i for i in sni_info.interfaces
                   if i.name == "org.kde.StatusNotifierItem")
        connection.register_object("/StatusNotifierItem", sni,
                                  self.on_sni_call, self.on_sni_get, None)

        menu_info = Gio.DBusNodeInfo.new_for_xml(menu_xml(MENU_INTERFACES))
        for interface in menu_info.interfaces:
            connection.register_object("/MenuBar", interface,
                                       self.on_menu_call, self.on_menu_get, None)

        # The bar (and its watcher) may still be starting when we are launched
        # from autostart, and it may be restarted later on. Retry until the
        # watcher accepts us, and again whenever a new watcher appears.
        connection.signal_subscribe(
            "org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
            "/org/freedesktop/DBus", "org.kde.StatusNotifierWatcher",
            Gio.DBusSignalFlags.NONE, self.on_watcher_changed)

    def on_watcher_changed(self, connection, sender, path, interface, signal, params):
        _name, _old, new = params.unpack()
        if new:
            self.register_with_watcher()

    def register_with_watcher(self):
        """Register the item; retry until the tray host is ready."""
        try:
            self.connection.call_sync(
                "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
                GLib.Variant("(s)", (self.service_name,)), None,
                Gio.DBusCallFlags.NONE, 3000, None)
        except GLib.Error:
            GLib.timeout_add(2000, self.register_with_watcher)
            return False

        if not self.registered:
            self.registered = True
            print(f"registered {self.service_name}", flush=True)
        return False

    def on_name_lost(self, connection, name):
        print(f"lost the bus name {name}", flush=True)
        self.loop.quit()

    # ---- the item ------------------------------------------------------
    def on_sni_get(self, connection, sender, path, interface, name):
        if name == "Category":
            return GLib.Variant("s", "ApplicationStatus")
        if name == "Id":
            return GLib.Variant("s", "oc-companion")
        if name == "Title":
            return GLib.Variant("s", "Opencode assistant")
        if name == "Status":
            return GLib.Variant("s", "Active")
        if name == "IconName":
            return GLib.Variant("s", "oc-companion")
        if name == "OverlayIconName":
            return GLib.Variant("s", "")
        if name == "AttentionIconName":
            return GLib.Variant("s", "")
        if name == "ToolTip":
            return GLib.Variant("(sa(iiay)ss)",
                                ("oc-companion", [],
                                 "Opencode assistant",
                                 "Click to talk, right click for options"))
        if name == "ItemIsMenu":
            return GLib.Variant("b", False)
        if name == "Menu":
            return GLib.Variant("o", "/MenuBar")
        return GLib.Variant("s", "")

    def on_sni_call(self, connection, sender, path, interface, method, params, invocation):
        if method == "Activate":
            companion_ipc("summon")
        elif method == "SecondaryActivate":
            companion_ipc("toggle")
        elif method == "ContextMenu":
            # The host draws the menu itself from the DBusMenu we export.
            pass
        invocation.return_value(None)

    # ---- the menu ------------------------------------------------------
    def on_menu_get(self, connection, sender, path, interface, name):
        if name == "Version":
            return GLib.Variant("u", 3)
        if name == "Status":
            return GLib.Variant("s", "normal")
        if name == "TextDirection":
            return GLib.Variant("s", "ltr")
        if name == "IconThemePath":
            return GLib.Variant("as", [])
        return None

    def on_menu_call(self, connection, sender, path, interface, method, params, invocation):
        try:
            self._menu_call(method, params, invocation)
        except Exception as exc:
            invocation.return_dbus_error("org.freedesktop.DBus.Error.Failed", str(exc))

    def _menu_call(self, method, params, invocation):
        if method == "GetLayout":
            parent, depth, _names = params.unpack()
            layout = build_layout(parent, depth)
            invocation.return_value(
                GLib.Variant("(u(ia{sv}av))", (1, layout)))
            return

        if method == "GetGroupProperties":
            ids, _names = params.unpack()
            out = []
            for iid in ids:
                out.append((iid, item_properties(iid)))
            invocation.return_value(GLib.Variant("(a(ia{sv}))", (out,)))
            return

        if method == "GetProperty":
            iid, name = params.unpack()
            value = item_properties(iid).get(name)
            if value is None:
                value = GLib.Variant("s", "")
            invocation.return_value(GLib.Variant("(v)", (value,)))
            return

        if method == "Event":
            iid, event_id, data, timestamp = params.unpack()
            if event_id == "clicked":
                for item, _label, action in MENU_ITEMS:
                    if item == iid:
                        if action == "reset":
                            subprocess.run(["oc-ask", "--reset"],
                                           stdout=subprocess.DEVNULL,
                                           stderr=subprocess.DEVNULL)
                        elif action == "settings":
                            subprocess.run(
                                ["omarchy-launch-editor", CONFIG],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        else:
                            companion_ipc(action)
                        break
            invocation.return_value(None)
            return

        if method in ("AboutToShow", "ContextMenuAboutToShow"):
            invocation.return_value(GLib.Variant("(b)", (False,)))
            return

        invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod",
                                     method)

    def run(self):
        self.loop.run()


def main(argv: list[str]) -> int:
    if "--icon" in argv:
        draw_icon()
        print(ICON_PATH)
        return 0

    Tray().run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/env python3
"""oc-voice-bridge - let agentvoice talk to the companion.

agentvoice can send its transcript to any OpenAI-compatible endpoint. This is
one: it takes what you said, hands it to the companion's opencode session,
and streams the answer back in the shape agentvoice expects. The companion
shows the exchange in her bubble and says it in her own chopped voice, so
agentvoice's own text-to-speech stays out of the way.

    oc-voice-bridge [--port 4098]
"""

from __future__ import annotations

import json
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 4098
HOST = "127.0.0.1"


def companion_ipc(function: str, *args: str) -> None:
    cmd = ["quickshell", "ipc", "-c", "companion", "call", "companion", function]
    cmd += list(args)
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass


def ask_companion(text: str) -> str:
    """Ask the companion's opencode session, and return the answer."""
    proc = subprocess.Popen(
        ["oc-ask", "--jsonl", text],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    answer = ""
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("type") == "reply":
            answer = event.get("text", "")
    proc.wait()
    return answer


def last_user_message(messages: list) -> str:
    for message in reversed(messages or []):
        if message.get("role") == "user":
            content = message.get("content")
            if isinstance(content, str):
                return content
            if isinstance(content, list):
                parts = [p.get("text", "") for p in content if isinstance(p, dict)]
                return " ".join(x for x in parts if x)
    return ""


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):  # keep the journal quiet
        pass

    def _json(self, code: int, payload: dict) -> None:
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.rstrip("/") in ("/health", ""):
            self._json(200, {"ok": True, "service": "oc-voice-bridge"})
        else:
            self._json(404, {"error": "not found"})

    def do_POST(self):
        if not self.path.rstrip("/").endswith("/chat/completions"):
            self._json(404, {"error": "not found"})
            return

        length = int(self.headers.get("Content-Length") or 0)
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            self._json(400, {"error": "bad json"})
            return

        question = last_user_message(body.get("messages") or [])
        if not question.strip():
            self._json(400, {"error": "no user message"})
            return

        # The answer is fetched on a worker so the socket can stay open while
        # the agent works.
        holder: dict = {}

        def work():
            try:
                holder["answer"] = ask_companion(question)
            except Exception as exc:  # noqa: BLE001 - report it as a reply
                holder["answer"] = f"({exc})"
            holder["done"] = True
            # Show it in her bubble, and let her say it in her own voice.
            companion_ipc("exchange", question, holder.get("answer", ""))

        threading.Thread(target=work, daemon=True).start()

        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()

        # Stream the answer out in pieces, the way a chat completion does.
        while not holder.get("done"):
            time.sleep(0.15)
        answer = holder.get("answer", "")
        for piece in answer.split(" "):
            if piece:
                chunk = {
                    "choices": [{"delta": {"content": piece + " "}, "index": 0,
                                 "finish_reason": None}]
                }
                self.wfile.write(f"data: {json.dumps(chunk)}\n\n".encode())
                self.wfile.flush()
                time.sleep(0.01)
        self.wfile.write(b"data: [DONE]\n\n")
        self.wfile.flush()


def main(argv: list[str]) -> int:
    global PORT
    args = argv[1:]
    if "--port" in args:
        PORT = int(args[args.index("--port") + 1])

    server = ThreadingHTTPServer((HOST, PORT), Handler)
    server.daemon_threads = True
    print(f"oc-voice-bridge listening on http://{HOST}:{PORT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
